PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Relational data: users, chats, memberships.
DATABASE_URL=postgresql://chat:chat@127.0.0.1:5432/chat?schema=public

# Redis db 2 keeps this app off the default db 0.
# Tests use db 3 so they do not steal jobs from a running dev server.
# Redis is optional. If it is not running, chat APIs still succeed.
# Unread counts and the send rate limit are skipped until Redis is up.
REDIS_URL=redis://127.0.0.1:6379/2

# Local Firestore emulator. Remove FIRESTORE_EMULATOR_HOST for a real project
# and set GOOGLE_APPLICATION_CREDENTIALS to a service account json.
FIREBASE_PROJECT_ID=demo-chat
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Sender can edit their own message for 15 minutes. Delete stays available.
EDIT_WINDOW_MS=900000

# Per-user cap on POST /message/send.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

MESSAGE_MAX_LENGTH=4000
GROUP_MAX_MEMBERS=200

# The API process also runs the BullMQ worker. Set false and run `npm run worker`
# when you want them in separate processes.
WORKER_ENABLED=true
